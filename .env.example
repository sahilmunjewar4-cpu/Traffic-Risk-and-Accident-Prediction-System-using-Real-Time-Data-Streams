# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional TomTom API Key for Live Nagpur Traffic Flow & Incidents
VITE_TOMTOM_API_KEY=""

# Optional OpenWeatherMap API Key for Live Nagpur Weather
VITE_WEATHER_API_KEY=""

# Optional Twilio credentials for SMS/WhatsApp Traffic Alerts
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
MY_WHATSAPP_NUMBER=""

